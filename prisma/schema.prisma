generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Page {
  id          Int       @id @default(autoincrement())
  wpId        Int?      @unique
  slug        String    @unique
  title       String
  content     String    @db.Text
  excerpt     String?   @db.Text
  status      String    @default("publish")
  parentId    Int?
  menuOrder   Int       @default(0)
  featuredId  Int?
  featured    Media?    @relation(fields: [featuredId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([status])
}

model Post {
  id          Int        @id @default(autoincrement())
  wpId        Int?       @unique
  sourceGuid  String?    @unique
  slug        String     @unique
  title       String
  content     String     @db.Text
  excerpt     String?    @db.Text
  status      String     @default("publish")
  featuredId  Int?
  featured    Media?     @relation(fields: [featuredId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  categories  Category[] @relation("PostCategories")
  tags        Tag[]      @relation("PostTags")

  @@index([slug])
  @@index([status])
}

model Media {
  id           Int      @id @default(autoincrement())
  wpId         Int?     @unique
  filename     String
  wpUrl        String?
  mimeType     String?
  url          String
  cloudinaryId String?  @unique
  alt          String?
  caption      String?
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
  pages        Page[]
  posts        Post[]
}

model Category {
  id          Int    @id @default(autoincrement())
  wpId        Int?   @unique
  slug        String @unique
  name        String
  description String?
  parentId    Int?
  posts       Post[] @relation("PostCategories")
}

model Tag {
  id    Int    @id @default(autoincrement())
  wpId  Int?   @unique
  slug  String @unique
  name  String
  posts Post[] @relation("PostTags")
}

model Menu {
  id    Int        @id @default(autoincrement())
  wpId  Int?       @unique
  name  String
  slug  String     @unique
  items MenuItem[]
}

model MenuItem {
  id        Int      @id @default(autoincrement())
  wpId      Int?     @unique
  menuId    Int
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId  Int?
  label     String
  url       String
  order     Int      @default(0)
  target    String?
}

model Subscriber {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  name        String?
  source      String    @default("newsletter")
  confirmedAt DateTime?
  unsubscribedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  handled   Boolean  @default(false)
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([handled])
}

model Donor {
  id        Int        @id @default(autoincrement())
  name      String?
  isPublic  Boolean    @default(true)
  email     String?    @unique
  phone     String?
  donations Donation[]
  createdAt DateTime   @default(now())
}

model Donation {
  id                   Int      @id @default(autoincrement())
  // For one-time Checkout: Stripe Checkout Session id.
  // For recurring renewals: Stripe Invoice id (each renewal is a separate row).
  // For self-reported bank transfers: `bank_<uuid>`.
  stripeSessionId      String   @unique
  // When the donation came from a recurring subscription (first payment or
  // renewal), the subscription id is recorded so the parish can see the
  // full history per pledge.
  stripeSubscriptionId String?
  amount               Int
  currency             String   @default("ron")
  campaign             String
  recurring            Boolean  @default(false)
  status               String   @default("completed")
  // Per-donation public/anonymous preference. Captured at donation time so
  // changing the flag later doesn't retroactively rewrite older entries.
  isPublic             Boolean  @default(true)
  donor                Donor?   @relation(fields: [donorId], references: [id])
  donorId              Int?
  createdAt            DateTime @default(now())

  @@index([campaign, createdAt])
  @@index([createdAt])
  @@index([stripeSubscriptionId])
}
