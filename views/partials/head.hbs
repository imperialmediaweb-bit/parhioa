<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} — Parohia Sf. Teodora de la Sihla</title>
  <meta name="description" content="{{description}}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Playfair+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <span class="logo-mark">✚</span>
        <span>Parohia "Sf.<br>Cuvioasă Teodora<br>de la Sihla"</span>
      </a>
      <nav class="main-nav">
        {{#if menu.length}}
          {{#each menu}}<a href="{{url}}">{{label}}</a>{{/each}}
        {{else}}
          <a href="/despre">Despre</a>
          <a href="/misiune">Misiune</a>
          <a href="/campanii">Campanii</a>
          <a href="/blog">Noutăți</a>
          <a href="/contact">Contact</a>
          <a href="/redirectioneaza-3-5">Redirecționează</a>
        {{/if}}
      </nav>
      <div class="header-actions">
        <a href="/doneaza" class="btn btn-cream">Donează</a>
        <a href="/contact" class="btn btn-red">Mesaj</a>
      </div>
    </div>
  </header>
