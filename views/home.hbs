{{> head title="Acasă" description="Site oficial al Parohiei Sfânta Cuvioasă Teodora de la Sihla, Botoșani."}}

<section class="hero">
  <h1>Credința care <em>zidește</em> împreună</h1>
  <p>Parohia Sfânta Cuvioasă Teodora de la Sihla din Botoșani — o comunitate în formare, prin rugăciune, milostenie și iubire creștină.</p>
</section>

<main class="container">
  {{#if page}}
    <article>
      <h1>{{page.title}}</h1>
      <div class="wp-content">{{{page.content}}}</div>
    </article>
  {{/if}}

  {{#if posts.length}}
    <h2 class="section-title">Noutăți din parohie</h2>
    <ul class="post-grid">
      {{#each posts}}
        <li class="card">
          {{#if featured.url}}<a href="/blog/{{slug}}"><img class="card-img" src="{{featured.url}}" alt="{{featured.alt}}"></a>{{/if}}
          <div class="card-body">
            <h3><a href="/blog/{{slug}}">{{title}}</a></h3>
            {{#if publishedAt}}<p class="date">{{date publishedAt}}</p>{{/if}}
            {{#if excerpt}}<p class="excerpt">{{excerpt}}</p>{{/if}}
          </div>
        </li>
      {{/each}}
    </ul>
  {{/if}}
</main>

{{> foot}}
