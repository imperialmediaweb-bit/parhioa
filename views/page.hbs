{{> head title=page.title description=page.excerpt}}

<section class="hero">
  <h1>{{page.title}}</h1>
  {{#if page.excerpt}}<p>{{page.excerpt}}</p>{{/if}}
  <p class="breadcrumbs"><a href="/">Home</a> › {{page.title}}</p>
</section>

<main class="container">
  <article>
    {{#if page.featured.url}}<img class="featured" src="{{page.featured.url}}" alt="{{page.featured.alt}}">{{/if}}
    <div class="wp-content">{{{page.content}}}</div>
  </article>
</main>

{{> foot}}
