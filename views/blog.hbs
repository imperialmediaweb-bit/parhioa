{{> head title="Noutăți" description="Vești din parohie și din viața bisericii"}}

<section class="hero">
  <h1>Blog</h1>
  <p>Vești din parohie și din viața bisericii. Aici găsiți noutăți despre Parohia Sfânta Cuvioasă Teodora de la Sihla, evenimente, slujbe și frumusețe duhovnicească.</p>
  <p class="breadcrumbs"><a href="/">Home</a> › Blog</p>
</section>

<main class="container">
  {{#if posts.length}}
    <ul class="post-grid">
      {{#each posts}}
        <li class="card">
          {{#if featured.url}}<a href="/blog/{{slug}}"><img class="card-img" src="{{featured.url}}" alt="{{featured.alt}}"></a>{{/if}}
          <div class="card-body">
            <h3><a href="/blog/{{slug}}">{{title}}</a></h3>
            {{#if publishedAt}}<p class="date">{{date publishedAt}}</p>{{/if}}
            {{#if excerpt}}<p class="excerpt">{{excerpt}}</p>{{/if}}
          </div>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p style="text-align:center;color:var(--text-muted);">Nu există articole publicate.</p>
  {{/if}}
</main>

{{> foot}}
